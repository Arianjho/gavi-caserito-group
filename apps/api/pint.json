{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "final_class": false,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "phpdoc_align": {
            "align": "left"
        },
        "no_superfluous_phpdoc_tags": false
    }
}