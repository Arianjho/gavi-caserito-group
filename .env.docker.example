# Variables del despliegue con docker-compose.prod.yml. Copia a .env.docker y completa.
# No subas .env.docker al repositorio.

# Puerto público de la web.
WEB_PORT=80

# --- Aplicación ---
APP_NAME="Gavi Caserito"
APP_ENV=production
APP_DEBUG=false
# Genera una con: docker run --rm composer:2 php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_URL=https://tu-dominio.com
FRONTEND_URL=https://tu-dominio.com
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Base de datos PostgreSQL (servicio aparte) ---
# El usuario NO debe ser superusuario ni tener BYPASSRLS, o se anula el aislamiento por cuenta.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=caserito
DB_USERNAME=caserito_owner
DB_PASSWORD=

# --- Correo (recuperación de contraseña) ---
MAIL_MAILER=log
